# WalletConnect Cloud project ID — https://cloud.reown.com
# (optional; without it, only injected browser wallets like MetaMask are offered)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Merchant / treasury address that receives testnet payments (EVM, 0x…)
RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional RPC overrides (public defaults are used when unset)
RPC_BASE_SEPOLIA=
RPC_ETHEREUM_SEPOLIA=
RPC_ARBITRUM_SEPOLIA=
RPC_OPTIMISM_SEPOLIA=
RPC_POLYGON_AMOY=

# Optional: Etherscan API key (v2 multichain) — enables QR auto-detection of
# incoming transfers. Without it, QR payers paste the tx hash manually.
ETHERSCAN_API_KEY=

# SQLite database file used by the API + verification worker
DATABASE_PATH=./data/airpay.db
