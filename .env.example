# WalletConnect Cloud project ID — https://cloud.reown.com
# (optional; without it, only injected browser wallets like MetaMask are offered)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Merchant / treasury address that receives testnet payments (EVM, 0x…)
RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional RPC overrides (public defaults are used when unset)
# NOTE: these must be TESTNET endpoints (Sepolia/Amoy), not mainnets.
RPC_BASE_SEPOLIA=
RPC_ETHEREUM_SEPOLIA=
RPC_ARBITRUM_SEPOLIA=
RPC_OPTIMISM_SEPOLIA=
RPC_POLYGON_AMOY=

# Optional: Etherscan API key (v2 multichain) — enables QR auto-detection of
# incoming transfers. Without it, QR payers paste the tx hash manually.
ETHERSCAN_API_KEY=

# --- Storage -------------------------------------------------------------
# Local dev: plain SQLite file (default below). Production (Vercel/serverless):
# set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN instead (https://turso.tech) —
# the local file is not shared across serverless isolates.
DATABASE_PATH=./data/airpay.db
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# --- Cron reconciler -----------------------------------------------------
# Protects GET /api/cron/verify (Bearer auth). Required on Vercel/production.
# Generate with: openssl rand -hex 32
CRON_SECRET=
