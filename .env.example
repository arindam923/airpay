# WalletConnect Cloud project ID — https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Merchant / treasury address that receives testnet payments (EVM, 0x…)
RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional RPC overrides (public defaults are used when unset)
RPC_BASE_SEPOLIA=
RPC_ETHEREUM_SEPOLIA=
RPC_ARBITRUM_SEPOLIA=
RPC_OPTIMISM_SEPOLIA=
RPC_POLYGON_AMOY=

# Optional: Etherscan API key
ETHERSCAN_API_KEY=

# --- Storage (Neon Postgres) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Social providers (optional) ---
# Also used by "Connect Google" in Settings → Sender email (scope: gmail.send).
# Add {BETTER_AUTH_URL}/api/email/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Cron reconciler ---
CRON_SECRET=

# --- Invoice email (Resend) ---
# Create a key at https://resend.com/api-keys and verify your sending domain.
RESEND_API_KEY=
# Sender for invoice emails. Must use a verified Resend domain.
EMAIL_FROM=AirPay <invoices@airpay.dev>

# Encrypts merchant-provided email credentials (Resend keys, SMTP passwords,
# Google refresh tokens). Falls back to BETTER_AUTH_SECRET when unset.
EMAIL_ENCRYPTION_KEY=

# --- Fees ---
# Platform fee percentage applied to payments (default 0.9 = 0.90%).
# Deprecated: superseded by the on-chain settlement fee below; kept as a fallback.
NEXT_PUBLIC_PRODUCT_FEE_PERCENT=0.9

# --- Settlement smart contract (testnet only) ---
# Private key of the platform admin/deployer. Owns the settlement contract and
# signs merchant registrations. Never commit a funded mainnet key here.
SETTLEMENT_ADMIN_PRIVATE_KEY=
# On-chain owner of the contract (defaults to the deployer). Optional.
SETTLEMENT_OWNER=
# Platform fee recipient — receives the 0.9% cut.
SETTLEMENT_TREASURY=
# Default merchant fee in basis points (90 = 0.90%).
SETTLEMENT_FEE_BPS_DEFAULT=90

# Deployed AirPaySettlement address per testnet (set after `forge script` deploy).
# Base Sepolia is the first target; the rest are placeholders for later rollout.
SETTLEMENT_BASE_SEPOLIA=
SETTLEMENT_ETHEREUM_SEPOLIA=
SETTLEMENT_ARBITRUM_SEPOLIA=
SETTLEMENT_OPTIMISM_SEPOLIA=
SETTLEMENT_POLYGON_AMOY=
