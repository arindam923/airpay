{
  "name": "airpay/airpay",
  "description": "Official AirPay PHP SDK.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://airpay.dev/docs",
  "support": {
    "docs": "https://airpay.dev/docs",
    "issues": "https://github.com/arindam923/airpay/issues",
    "source": "https://github.com/arindam923/airpay-php"
  },
  "authors": [
    {
      "name": "AirPay",
      "email": "hello@airpay.dev"
    }
  ],
  "keywords": [
    "airpay",
    "payments",
    "crypto",
    "stablecoin",
    "usdc",
    "checkout",
    "sdk"
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "AirPay\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AirPay\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
